+const PASSWORD_CHARSETS = {
+  upper: { label: "Uppercase", chars: "ABCDEFGHIJKLMNOPQRSTUVWXYZ" },
+  lower: { label: "Lowercase", chars: "abcdefghijklmnopqrstuvwxyz" },
